# Copie este arquivo para .env (schema/migrations) e .env.local (runtime do Next.js),
# ou apenas para .env — o Next.js também lê .env. Nunca commitar o arquivo real.

# String de conexão do Postgres (Neon, Vercel Postgres, Supabase, ou local).
# Formato: postgresql://usuario:senha@host/banco?sslmode=require
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Senha simples para proteger o app (uso pessoal, um usuário só).
# Definida por você; usada pelo middleware de autenticação básica.
APP_PASSWORD="troque-esta-senha"
